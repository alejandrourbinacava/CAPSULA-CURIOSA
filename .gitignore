# deps
node_modules/
# secretos (las API keys van en GitHub Secrets, NUNCA en el repo)
.env
# salidas de render
out/
# temporales de generación de voz
public/voz1deep/_raw/
public/voz1full/_raw/
public/voz1/_raw/
# logs
*.log
npm-debug.log*
# --- pipeline spec ---
# IMPORTANTE: el audio de voz por episodio SÍ se versiona a propósito.
#   Es de pago (genaipro) y se genera UNA sola vez; los re-renders lo reutilizan.
#   (Solo ignoramos el _raw.mp3 intermedio, no el audio.mp3 final ni words.json.)
episodes/**/_raw.mp3
# assets descargados (Wikipedia/Iconify) - los rebaja 01-assets, gratis
public/assets/
# audio del render activo (copia; el original vive en episodes/<slug>/audio.mp3)
public/active/audio.mp3
