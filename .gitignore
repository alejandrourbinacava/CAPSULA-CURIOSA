# deps
node_modules/
# secretos (las API keys van en GitHub Secrets, NUNCA en el repo)
.env
# salidas de render
out/
# temporales de generación de voz
public/voz1deep/_raw/
public/voz1full/_raw/
public/voz1/_raw/
# logs
*.log
npm-debug.log*
# --- pipeline spec ---
# IMPORTANTE: el audio de voz por episodio SÍ se versiona a propósito.
#   Es de pago (genaipro) y se genera UNA sola vez; los re-renders lo reutilizan.
#   (Solo ignoramos el _raw.mp3 intermedio, no el audio.mp3 final ni words.json.)
episodes/**/_raw.mp3
# assets descargados por episodio (fotos Wikipedia + copias) - se rebajan gratis en cada run
public/assets/icons/
public/assets/misc/
# PERO la LIBRERÍA de dibujos GPT (de pago) SÍ se versiona: registro global reutilizable
#   -> la nube reutiliza estos doodles y NO vuelve a gastar en OpenAI. public/assets/library/ SÍ se commitea.
# audio del render activo (copia; el original vive en episodes/<slug>/audio.mp3)
public/active/audio.mp3

# artefactos de verificación (se regeneran)
episodes/**/debug/

# media regenerable / no usada (clips, gifs, iconos offline, placeholders)
public/assets/clips/
public/assets/gifs/
public/assets/archive/
public/icons/
public/media/
